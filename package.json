{
  "name": "personal-music",
  "version": "0.18.0",
  "private": true,
  "description": "veyww — персональный музыкальный плеер",
  "author": "veyww",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node desktop/server.cjs",
    "test": "node --test tests/*.test.mjs",
    "prepare:web": "node desktop/prepare.cjs",
    "build:win": "electron-builder --win nsis --x64",
    "build:mac": "electron-builder --mac zip"
  },
  "dependencies": {
    "@soundtouchjs/audio-worklet": "2.1.1",
    "hls.js": "1.7.3",
    "@simplewebauthn/server": "14.0.3",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "26.0.12",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "local.personal.music.next",
    "productName": "veyww",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/*.cjs",
      "desktop/island.html",
      "web/**",
      "!web/vendor/**/*.map",
      "!web/vendor/**/*.d.ts",
      "!web/vendor/**/test*",
      "package.json",
      "!desktop/*host.cjs",
      "!desktop/prepare*.cjs",
      "desktop/*.css",
      "desktop/*.ps1"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "web/assets/app.ico"
    },
    "mac": {
      "category": "public.app-category.music"
    },
    "artifactName": "veyww-Windows-${version}-Setup.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "veyww",
      "deleteAppDataOnUninstall": false
    }
  }
}